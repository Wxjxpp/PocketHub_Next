<?xml version="1.0" encoding="utf-8"?>
<!-- PocketHub launcher foreground: a stylised pocket + hub node mark.
     Drawn inside the 108dp adaptive-icon viewport with content kept in the
     safe zone (28..80) so circular/squircle masks never clip it.
     The ring uses an accent gradient (teal → blue) for identity against
     the dark #0D1117 GitHub-ish background. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ═══ Mark: rounded-square "pocket" ring with accent gradient ═══ -->
    <path
        android:pathData="M40,28 L68,28 A12,12 0 0 1 80,40 L80,68 A12,12 0 0 1 68,80 L40,80 A12,12 0 0 1 28,68 L28,40 A12,12 0 0 1 40,28 Z"
        android:strokeWidth="6"
        android:fillColor="#00000000">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:strokeColor">
            <gradient
                android:startX="28" android:startY="28"
                android:endX="80" android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF2DD4BF" />
                <item android:offset="1.0" android:color="#FF3B82F6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ═══ Pocket flap: V shape dipping into the square ═══ -->
    <path
        android:pathData="M36,44 L54,62 L72,44"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white" />

    <!-- ═══ Hub node: filled circle under the flap ═══ -->
    <path
        android:pathData="M54,68 m-7,0 a7,7 0 1 1 14,0 a7,7 0 1 1 -14,0"
        android:fillColor="@android:color/white" />

    <!-- Small orbit dots flanking the hub — "hub & spokes" feel. -->
    <path
        android:pathData="M40,70 m-3,0 a3,3 0 1 1 6,0 a3,3 0 1 1 -6,0"
        android:fillColor="@android:color/white"
        android:fillAlpha="0.85" />
    <path
        android:pathData="M68,70 m-3,0 a3,3 0 1 1 6,0 a3,3 0 1 1 -6,0"
        android:fillColor="@android:color/white"
        android:fillAlpha="0.85" />

</vector>
